# Backend
DATABASE_URL=postgresql+asyncpg://bitacora:bitacora@db:5432/bitacora
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Trello (crea un Power-Up / API key en https://trello.com/power-ups/admin)
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=

# En producción, DATABASE_URL apunta al connection string de Supabase:
# postgresql+asyncpg://postgres:<password>@<proyecto>.supabase.co:5432/postgres

# Firma las cookies de sesión (login por PIN). Generar con: openssl rand -hex 32
SECRET_KEY=

# Supabase Storage (adjuntos del chat). URL del proyecto + Service Role Key
# (Project Settings > API en el dashboard de Supabase). El bucket debe existir
# y llamarse igual que CHAT_BUCKET (o cambia el nombre aquí).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
CHAT_BUCKET=chat-adjuntos
